{
  "name": "silver-3ds-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "prebuild": "node scripts/ensure-packed-model.mjs && node scripts/check-lcd-display.mjs",
    "predev": "node scripts/ensure-packed-model.mjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "start:verify": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "vgpu": "vgpu",
    "check:shader": "vgpu check src/shaders/silver.wgsl --require-validation",
    "check:lcd-display": "node scripts/check-lcd-display.mjs",
    "test:lcd-display": "node scripts/test-lcd-display.mjs"
  },
  "dependencies": {
    "@vgpu/wgsl": "^0.4.1",
    "next": "16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "0.186.0",
    "vgpu": "^0.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.183.0",
    "meshoptimizer": "^1.2.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
